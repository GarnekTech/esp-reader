#include <Arduino.h>
#include <GyverOLED.h>
#include <FS.h>
#include <LittleFS.h>

GyverOLED<SSD1306_128x64, OLED_BUFFER> oled;

#define PIN_UP   5
#define PIN_SEL  6
#define PIN_DOWN 7

#define SLEEP_HOLD_MS 3000
#define MAX_CHARS_PER_LINE 20

String fileList[10];
int fileCount = 0;
int currentFileIdx = 0;

bool inMenu = true;
String currentText = "";
int scrollLine = 0;

int lineStarts[300]; 
int totalLines = 0;

int getUtf8CharLength(unsigned char c) {
  if ((c & 0x80) == 0) return 1;
  else if ((c & 0xE0) == 0xC0) return 2;
  else if ((c & 0xF0) == 0xE0) return 3;
  else if ((c & 0xF8) == 0xF0) return 4;
  return 1;
}

void loadFileList() {
  fileCount = 0;
  File root = LittleFS.open("/");
  File file = root.openNextFile();
  while (file && fileCount < 10) {
    String name = String(file.name());
    if (name.endsWith(".txt")) {
      fileList[fileCount] = name;
      fileCount++;
    }
    file = root.openNextFile();
  }
}

void renderMenu() {
  oled.clear();
  oled.home();
  oled.setScale(1);
  oled.println("=== ФАЙЛЫ ===");
  oled.println();

  for (int i = 0; i < fileCount; i++) {
    if (i == currentFileIdx) oled.print("> ");
    else oled.print("  ");
    oled.println(fileList[i]);
  }

  oled.update();
}

void prepareTextLines() {
  totalLines = 0;
  lineStarts[0] = 0;
  totalLines++;

  int charCountInLine = 0;
  int i = 0;
  int textLen = currentText.length();

  while (i < textLen && totalLines < 300) {
    char c = currentText[i];
    int charBytes = getUtf8CharLength((unsigned char)c);

    if (c == '\n') {
      i += charBytes;
      lineStarts[totalLines] = i;
      totalLines++;
      charCountInLine = 0;
      continue;
    }

    if (charCountInLine >= MAX_CHARS_PER_LINE) {
      lineStarts[totalLines] = i;
      totalLines++;
      charCountInLine = 0;
    }

    charCountInLine++;
    i += charBytes;
  }
}

void openFile(String path) {
  if (!path.startsWith("/")) path = "/" + path;
  File f = LittleFS.open(path, "r");
  if (!f) return;
  currentText = f.readString();
  f.close();
  
  prepareTextLines();
  scrollLine = 0;
  inMenu = false;
}

void renderReader() {
  oled.clear();
  oled.home();
  oled.setScale(1);

  for (int l = 0; l < 7; l++) {
    int currentLineIdx = scrollLine + l;
    if (currentLineIdx >= totalLines) break;

    int startByte = lineStarts[currentLineIdx];
    int endByte = (currentLineIdx + 1 < totalLines) ? lineStarts[currentLineIdx + 1] : currentText.length();

    String lineStr = currentText.substring(startByte, endByte);
    lineStr.replace("\n", "");
    lineStr.replace("\r", "");

    oled.println(lineStr);
  }

  oled.update();
}

void enterDeepSleep() {
  oled.clear();
  oled.setCursor(10, 3);
  oled.print("Выключение...");
  oled.update();
  delay(1000);
  
  oled.clear();
  oled.setPower(false);

  esp_sleep_enable_ext0_wakeup((gpio_num_t)PIN_SEL, 0);
  esp_deep_sleep_start();
}

void setup() {
  pinMode(PIN_UP, INPUT_PULLUP);
  pinMode(PIN_SEL, INPUT_PULLUP);
  pinMode(PIN_DOWN, INPUT_PULLUP);

  Wire.begin(8, 9);
  oled.init();
  oled.setPower(true);
  oled.clear();

  if (!LittleFS.begin(true)) {
    oled.print("Ошибка LittleFS");
    oled.update();
    while (1);
  }

  loadFileList();
  renderMenu();
}

void loop() {
  if (digitalRead(PIN_SEL) == LOW) {
    unsigned long pressStart = millis();
    bool handledSleep = false;

    while (digitalRead(PIN_SEL) == LOW) {
      if (millis() - pressStart >= SLEEP_HOLD_MS) {
        enterDeepSleep();
        handledSleep = true;
        break;
      }
      delay(10);
    }

    if (!handledSleep) {
      delay(50);
      if (inMenu) {
        if (fileCount > 0) {
          openFile(fileList[currentFileIdx]);
          renderReader();
        }
      } else {
        inMenu = true;
        renderMenu();
      }
    }
  }

  if (digitalRead(PIN_UP) == LOW) {
    delay(120);
    if (inMenu) {
      if (currentFileIdx > 0) currentFileIdx--;
      renderMenu();
    } else {
      if (scrollLine > 0) {
        scrollLine--;
        renderReader();
      }
    }
  }

  if (digitalRead(PIN_DOWN) == LOW) {
    delay(120);
    if (inMenu) {
      if (currentFileIdx < fileCount - 1) currentFileIdx++;
      renderMenu();
    } else {
      if (scrollLine < totalLines - 7) {
        scrollLine++;
        renderReader();
      }
    }
  }
}
